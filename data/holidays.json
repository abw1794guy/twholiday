  "monthly_travel_tips": {
    "1": {
      "season": "冬季",
      "theme": "雪祭・滑雪・東南亞避寒",
      "highlights": "一月是台灣難得的冬日，也是出遊搶佔年假的好時機。日本北海道滑雪場正值旺季，東南亞氣候宜人，歐洲則有壯闊的冬日山景。",
      "tips": [
        "北海道新雪谷、富良野滑雪──旺季雪況最佳，建議提前 2 個月訂房",
        "日本東北藏王樹冰奇景（1 月下旬最美）",
        "泰國清邁花卉節（Chiang Mai Flower Festival，2 月）準備期，提前訂位",
        "馬來西亞・新加坡避寒輕旅行，機票淡季較便宜",
        "歐洲滑雪勝地：瑞士策馬特（Zermatt）、奧地利茵斯布魯克"
      ]
    },
    "2": {
      "season": "冬末",
      "theme": "賞梅・滑雪尾聲・溫泉",
      "highlights": "二月氣溫回升，日本關西梅花開始綻放，北海道滑雪仍在旺季。搭配春節連假，是海外旅遊需求最旺的月份，建議提前規劃。",
      "tips": [
        "京都北野天滿宮、大阪城公園梅花（2 月中旬盛開）",
        "北海道大雪山系滑雪（旺季延伸至 3 月初）",
        "日本九州別府・由布院溫泉，冬季泡湯最舒適",
        "首爾南山、三清洞冬日散策，韓服體驗",
        "沖繩已開始入春，適合海島微旅行"
      ]
    },
    "3": {
      "season": "初春",
      "theme": "滑雪尾聲・賞梅賞花・歐洲準備",
      "highlights": "三月台灣無國定假日，但卻是旅遊性價比最高的月份之一。北海道滑雪季延續至 3 月底，日本東部進入賞梅尾聲，全球各地花季接力開展。",
      "tips": [
        "北海道二世谷・星野 TOMAMU 滑雪（3 月底前最後機會）",
        "日本東京、橫濱梅花→ 3 月下旬開始觀賞早開品種的染井吉野",
        "台灣武陵農場、阿里山（桃花、福壽山農場梅花），不用出國也美",
        "歐洲荷蘭庫肯霍夫鬱金香公園（3/20–5/11 開園），可先訂機票",
        "越南河內、峴港氣候宜人，正是旅遊淡旺季交接最划算的時機"
      ]
    },
    "4": {
      "season": "春季",
      "theme": "日本賞櫻・歐洲花海",
      "highlights": "四月是全球旅遊旺季的起點。日本本州染井吉野進入盛開，荷蘭鬱金香達到頂峰，是一年中最值得規劃長程旅遊的月份。",
      "tips": [
        "京都哲學之道・円山公園夜間賞櫻",
        "東京上野公園・目黑川盛開期（3 月底 ─ 4 月初）",
        "荷蘭庫肯霍夫鬱金香公園（4 月上旬是花況最盛時段）",
        "弘前城（青森）晚開品種 4 月下旬才盛開，人潮較少",
        "台灣武陵農場武陵四秀登山、梨山桃花"
      ]
    },
    "5": {
      "season": "初夏",
      "theme": "東南亞・地中海・韓國玫瑰",
      "highlights": "五月台灣開始悶熱，是逃往更舒適氣候的好時機。歐洲南部進入初夏，東南亞（避開雨季高發區）旅遊仍宜人，韓國各地薔薇花季也在此時盛開。",
      "tips": [
        "韓國首爾月드公園・中浪川玫瑰花節（5 月中旬）",
        "義大利托斯卡納鄉村・威尼斯水都，初夏遊客尚未暴增",
        "希臘聖托里尼・米科諾斯──5 月是黃金旺季前的最後淡季機票窗口",
        "峇里島（雨季已結束）、泰國清邁、越南峴港──氣候舒適",
        "台灣花東縱谷油菜花後轉稻田翠綠期，和平島、龜山島浮潛"
      ]
    },
    "6": {
      "season": "夏季",
      "theme": "北海道薰衣草・冰島極晝・歐洲夏日",
      "highlights": "六月是北海道薰衣草的準備季，富良野下旬開始轉紫。冰島進入極晝白夜，北歐享受最長的白天。歐洲各城市進入夏日市集與音樂節旺季。",
      "tips": [
        "北海道富良野薰衣草（6 月底先行品種開放，Farm Tomita）",
        "冰島極晝・冰川健行・午夜陽光（6 月 21 日夏至最長白晝）",
        "瑞典哥特堡仲夏節（Midsommar）傳統慶典，體驗北歐文化",
        "英國倫敦夏日：大英博物館、查塔姆花園展開放",
        "加拿大溫哥華・維多利亞花卉盛開，楓葉國初夏清爽宜人"
      ]
    },
    "7": {
      "season": "暑假旺季",
      "theme": "薰衣草・地中海・南半球冬季",
      "highlights": "七月是全球最熱門的旅遊旺季。北海道薰衣草達到全盛期，地中海沙灘進入最美時節。台灣暑假出發海外正盛，南半球迎來冬季壯闊景觀。",
      "tips": [
        "北海道富良野薰衣草全盛期（7 月上中旬，Farm Tomita 熱帶花卉與薰衣草同框）",
        "希臘聖托里尼・克里特島──藍頂白牆配碧海藍天正是最美時節",
        "克羅埃西亞普利特維切湖泊國家公園──7 月水量豐沛、翠藍最美",
        "紐西蘭南島・澳洲塔斯馬尼亞南半球冬季──世界盡頭的星空",
        "日本祭典季：京都祇園祭（7/17 山鉾巡行）、仙台七夕準備"
      ]
    },
    "8": {
      "season": "仲夏",
      "theme": "北歐峽灣・日本夏祭・紐澳",
      "highlights": "八月是暑假旅遊最後衝刺。北歐峽灣氣候最穩定，挪威蓋倫格峽灣壯麗壯闊。日本東北夏祭在此時登場，仙台七夕、秋田竿燈祭熱鬧非凡。",
      "tips": [
        "挪威蓋倫格峽灣・松恩峽灣遊輪，8 月天氣最穩定",
        "日本仙台七夕祭（8/6–8/8）、秋田竿燈祭（8/3–8/6）",
        "芬蘭赫爾辛基・桑拿文化體驗，北歐設計購物",
        "冰島極光季起跑（8 月底可見微弱極光）",
        "紐澳南半球：紐西蘭南島米佛峽灣健行、澳洲大堡礁潛水"
      ]
    },
    "9": {
      "season": "初秋",
      "theme": "加拿大楓葉・日本紅葉先行・歐洲葡萄酒",
      "highlights": "九月是秋季旅遊的序幕。加拿大東部楓葉提前轉紅，北海道大雪山系楓葉先行，歐洲法國義大利進入葡萄酒豐收季，是旅遊性價比回升的月份。",
      "tips": [
        "加拿大魁北克・蒙特婁，9 月底楓葉轉紅，先行品種最鮮豔",
        "北海道大雪山旭岳楓葉（9 月中旬台灣最早看到紅葉）",
        "法國波爾多・布根地葡萄酒豐收季（Vendange），品酒體驗",
        "義大利托斯卡納聖吉米尼亞諾・奇揚地葡萄莊園遊",
        "日本輕井澤・長野初秋微涼，高原避暑賞楓起跑"
      ]
    },
    "10": {
      "season": "秋季",
      "theme": "日韓楓葉・德國慕尼黑啤酒節",
      "highlights": "十月是東亞楓葉最美的月份。日本本州山區楓葉由北往南推進，韓國雪嶽山楓葉進入全盛，德國慕尼黑啤酒節的尾聲仍熱鬧。",
      "tips": [
        "日本日光東照宮・奈良公園楓葉（10 月下旬轉紅）",
        "韓國雪嶽山單節楓葉（10 月上中旬最佳）",
        "日本京都嵐山・東福寺楓葉預報期（11 月全盛，10 月末可先卡位）",
        "德國慕尼黑啤酒節（Oktoberfest，9 月末–10 月初）尾聲",
        "台灣合歡山翠峰、大雪山楓樹林步道，國內楓葉秘境"
      ]
    },
    "11": {
      "season": "深秋",
      "theme": "京都楓葉全盛・歐洲聖誕市集開跑",
      "highlights": "十一月台灣天氣轉涼舒適，是長途旅行的絕佳時機。京都楓葉進入全盛期，德國紐倫堡、維也納聖誕市集開幕，歐洲秋冬氛圍最濃厚。",
      "tips": [
        "京都東福寺・永觀堂夜間楓葉點燈（11 月中下旬）",
        "奈良吉野山・三重投宿溫泉旅館紅葉泡湯",
        "德國紐倫堡聖誕市集（11/28 開幕）、奧地利維也納市政廳廣場",
        "捷克布拉格・匈牙利布達佩斯聖誕市集，中歐冬日巡禮",
        "新加坡・馬來西亞（11 月東北季風影響較小，氣候宜人）"
      ]
    },
    "12": {
      "season": "冬季",
      "theme": "聖誕市集・跨年倒數・初滑雪",
      "highlights": "十二月是一年中最有儀式感的旅行月份。歐洲聖誕市集達到全盛，日本各地初雪紛飛，跨年前夕全球倒數慶典熱鬧登場。",
      "tips": [
        "歐洲聖誕市集巡禮：德國科隆・法國史特拉斯堡・比利時布魯塞爾",
        "日本東京・大阪跨年：明治神宮初詣、道頓堀倒數人潮",
        "北海道二世谷・星野 TOMAMU 初滑雪（12 月底開板）",
        "沖繩跨年海島旅行，避開本島冬寒（沖繩最低約 15°C）",
        "台北跨年 101 煙火，結合信義區聖誕裝置藝術夜間散策"
      ]
    }
  },
